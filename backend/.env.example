# Salin ke backend/.env (file ini di-gitignore). Jangan commit kredensial.

# PostgreSQL / Supabase (wajib). Di docker-compose nilai ini ditimpa ke Postgres lokal.
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database khusus test (pytest DROP & CREATE semua tabel — JANGAN pakai DB asli).
TEST_DATABASE_URL=postgresql://mrp:mrp@localhost:5433/mrp_test

# --- Chatbot (SAP AI Core / Generative AI Hub) ---
# Dari keybroker: clientid, clientsecret, url (-> AUTH_URL), serviceurls.AI_API_URL (-> BASE_URL).
# Akhiran /oauth/token dan /v2 ditambahkan otomatis bila tidak ada.
AICORE_AUTH_URL=https://aws-sap-hackathon-si4ykj9d.authentication.ap10.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=sb-949c5904-cced-43f2-9d54-d7d672248966!b111833|aicore!b1456
AICORE_CLIENT_SECRET=fd43b994-bf58-4b5d-b695-13a87e44ec8f$ieyiUASfz2oIcQLjE76U_EX0AcjXWRBCVdioXETIPwY=
AICORE_BASE_URL=https://api.ai.prod.ap-southeast-2.aws.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=default

# Opsional: role read-only untuk query chatbot (default: DATABASE_URL dalam transaksi READ ONLY).
