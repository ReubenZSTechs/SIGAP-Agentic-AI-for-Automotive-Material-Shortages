{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation_clarifier.schema.json",
  "title": "AutomationClarifierOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_text",
    "options"
  ],
  "properties": {
    "question_text": {
      "type": "string",
      "description": "One short, friendly clarification question in the user's language."
    },
    "options": {
      "type": "array",
      "description": "Subset of the provided option values to offer as quick replies (may be empty).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  }
}
