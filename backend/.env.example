# Salin ke backend/.env (file ini di-gitignore). Jangan commit kredensial.

# development = Postgres lokal (docker compose). URL Supabase DITOLAK di development & test.
# production  = SAP BTP + Supabase; nilai diisi lewat manifest.yml + deploy/vars.yml (docs/DEPLOYMENT.md).
APP_ENV=development

# Satu database untuk aplikasi + chatbot (chatbot membaca dalam transaksi READ ONLY).
# Di docker-compose nilai ini ditimpa ke service `db`; dari host pakai port 5433.
DATABASE_URL=postgresql://mrp:mrp@localhost:5433/mrp
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database khusus test (pytest DROP & CREATE semua tabel — selalu Postgres lokal, Supabase ditolak).
TEST_DATABASE_URL=postgresql://mrp:mrp@localhost:5433/mrp_test

# --- Chatbot (SAP AI Core / Generative AI Hub) ---
# Dari keybroker: clientid, clientsecret, url (-> AUTH_URL), serviceurls.AI_API_URL (-> BASE_URL).
# Akhiran /oauth/token dan /v2 ditambahkan otomatis bila tidak ada.
AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=<clientid>
AICORE_CLIENT_SECRET=<clientsecret>
AICORE_BASE_URL=https://api.ai.<region>.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=default

# --- Supplier Telegram (docs/SUPPLIER_TELEGRAM.md) ---
# sandbox  = pesan hanya disimpan di DB; peran supplier & manajer dimainkan lewat Hub Supplier
# telegram = Bot API sungguhan (jalankan worker: python -m app.supplier_chat.worker)
TELEGRAM_MODE=sandbox
# TELEGRAM_BOT_TOKEN=<token dari @BotFather>
# TELEGRAM_BOT_USERNAME=<username bot tanpa @>
# TELEGRAM_MANAGER_CHAT_ID=<chat id manajer, mis. dari @userinfobot>
