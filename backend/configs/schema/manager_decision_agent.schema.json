{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manager_decision_agent.schema.json",
  "title": "ManagerDecisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "choice",
    "change_request_id",
    "reply_text"
  ],
  "properties": {
    "choice": {
      "type": "string",
      "enum": [
        "abort",
        "approve_change",
        "resource",
        "unclear"
      ]
    },
    "change_request_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Id of the pending change request the manager refers to; null if unclear."
    },
    "reply_text": {
      "type": "string",
      "description": "Short reply to the manager (asked again when the choice is unclear)."
    }
  }
}
