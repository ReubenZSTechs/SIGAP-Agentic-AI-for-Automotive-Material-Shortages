{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct_responder.schema.json",
  "title": "DirectResponderOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": {"type": "string", "enum": ["text"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
