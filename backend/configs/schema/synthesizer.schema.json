{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesizer.schema.json",
  "title": "SynthesizerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks", "claims", "insufficient_data"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "evidence_id", "columns", "title"],
        "properties": {
          "type": {"type": "string", "enum": ["text", "table"]},
          "text": {"type": ["string", "null"], "description": "Markdown-free prose; required for text blocks."},
          "evidence_id": {"type": ["string", "null"], "description": "Evidence id (e.g. E1) whose rows the table renders."},
          "columns": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "Evidence column names to show, in order; required for table blocks."
          },
          "title": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Every factual statement made in the text blocks, each tied to the evidence that supports it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "insufficient_data": {"type": "boolean", "description": "True when the evidence cannot answer the question."}
  }
}
