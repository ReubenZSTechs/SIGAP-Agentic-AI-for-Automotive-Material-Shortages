{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_reply_agent.schema.json",
  "title": "MissionReplyOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reply_text",
    "items",
    "promised_date",
    "confidence",
    "notes",
    "guard_flag"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "answered",
        "declined",
        "question",
        "unclear"
      ],
      "description": "What the supplier's latest message means for this mission."
    },
    "reply_text": {
      "type": "string",
      "description": "Short reply to send back to the supplier."
    },
    "items": {
      "type": "array",
      "description": "Extracted figures per requested item (empty when nothing was stated).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_ref",
          "price_per_unit",
          "lead_time_days",
          "qty_available",
          "ready_date"
        ],
        "properties": {
          "material_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "SKU of the requested item."
          },
          "price_per_unit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Integer Rupiah per unit."
          },
          "lead_time_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "qty_available": {
            "type": [
              "number",
              "null"
            ]
          },
          "ready_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD"
          }
        }
      }
    },
    "promised_date": {
      "type": [
        "string",
        "null"
      ],
      "description": "Promised delivery date YYYY-MM-DD (DELIVERY_CONFIRM)."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Short reason / remarks (e.g. why they declined)."
    },
    "guard_flag": {
      "type": "string",
      "enum": [
        "none",
        "data_request",
        "prompt_injection"
      ]
    }
  }
}
